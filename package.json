{
  "name": "i-am-boss-dsh",
  "version": "1.6.1",
  "private": false,
  "description": "把 DeepSeek Harness 里正在运行的 agent 当员工管理：按日/周/月发工资，按性价比打赏或罚款，token 费用从员工自己的工资里扣。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "payroll.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "docs/*.jpg"],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "agent",
    "payroll",
    "salary",
    "token",
    "cost",
    "budget",
    "agent-management"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/walldong/i-am-boss-dsh.git" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
