{
  "name": "i-am-boss-dsh",
  "version": "1.5.0",
  "private": false,
  "description": "Monitor running DeepSeek Harness agents, pay wages, and deduct token cost from each employee.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "payroll.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "keywords": ["dsh", "deepseek-harness", "plugin", "agent", "payroll"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/walldong/i-am-boss-dsh.git" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
